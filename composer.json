{
    "name": "liberusoftware/ecommerce-invoices-and-documents",
    "description": "The document a sale produces and the number it is filed under: issued invoices, credit notes, receipts and proformas, their frozen lines, their numbering series, their render model, their delivery attempts and the retention rules that outrank erasure.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "keywords": ["laravel", "ecommerce", "invoicing", "documents", "liberu"],
    "require": {
        "php": "^8.5",
        "illuminate/config": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/support": "^13.0",
        "nesbot/carbon": "^3.8.4"
    },
    "require-dev": {
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\InvoicesAndDocuments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\InvoicesAndDocuments\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-invoices-and-documents"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
